# PostgreSQL connection string for Prisma (e.g. Neon, Supabase, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/setu_db?schema=public"

# Server Port (default 4000)
PORT=4000

# Optional Frontend URL for CORS (e.g. https://setu-wi95.vercel.app)
# If left blank, localhost and all *.vercel.app preview URLs are allowed automatically.
FRONTEND_URL=
